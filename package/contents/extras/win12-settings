#!/bin/sh
# Open the Win12 settings window: poke a config key the first Win12 widget listens to.
QD=$(command -v qdbus6 || command -v qdbus-qt6 || { [ -x /usr/lib/qt6/bin/qdbus ] && echo /usr/lib/qt6/bin/qdbus; } || echo qdbus)
exec "$QD" org.kde.plasmashell /PlasmaShell evaluateScript '
var found = false;
panels().concat(desktops()).forEach(function (c) {
    c.widgets("org.win12.menu").forEach(function (w) {
        if (found) return;
        w.currentConfigGroup = ["General"];
        w.writeConfig("openSettingsRequest", String(Date.now()));
        w.reloadConfig();
        found = true;
    });
});
print(found ? "opened" : "Win12 is not on a panel");'
